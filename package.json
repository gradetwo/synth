{
  "name": "groove-synth-gs1",
  "private": true,
  "version": "2.0.5",
  "type": "module",
  "description": "GROOVE SYNTH GS-1 — industrial-grade WebAssembly polyphonic synthesizer with a Rust DSP core, AudioWorklet rendering and a fully offline PWA shell.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:sw": "node scripts/gen-sw.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "build": "npm run build:wasm && tsc -b && vite build && npm run build:sw",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path crates/synth-core/Cargo.toml -- --test-threads=1",
    "test:all": "npm run test:rust && npm run test",
    "typecheck": "tsc -b --force",
    "package": "npm run build && node scripts/package.mjs",
    "test:wasm": "npm run build:wasm && node scripts/verify-wasm.mjs && node scripts/verify-wasm.mjs src/generated/synth_core_scalar.wasm && node scripts/verify-wasm-features.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:budget": "node scripts/verify-budget.mjs",
    "verify:audio": "node scripts/verify-audio.mjs",
    "verify:presets": "node scripts/verify-presets.mjs",
    "verify:presets:2x": "node scripts/verify-presets.mjs --oversampled",
    "presets:update": "node scripts/verify-presets.mjs --update",
    "presets:update:2x": "node scripts/verify-presets.mjs --update --oversampled",
    "verify:clippy": "cargo clippy --manifest-path crates/synth-core/Cargo.toml --all-targets -- -D clippy::correctness -D clippy::suspicious -D clippy::perf -A clippy::not_unsafe_ptr_arg_deref",
    "verify": "npm run verify:clippy && npm run test:rust && npm run build && npm run test && npm run lint && npm run test:wasm && npm run verify:ci && npm run verify:release && npm run verify:dist && npm run verify:budget && npm run verify:audio && npm run verify:presets && npm run verify:presets:2x && npm run verify:bench && npm run test:dsp && npm run verify:dsp:2x",
    "test:dsp": "node scripts/dsp-baseline.mjs",
    "verify:dsp:2x": "node scripts/dsp-baseline.mjs --oversampled",
    "test:e2e:webkit": "playwright test --project=webkit --workers=1",
    "test:e2e:webkit:headed": "xvfb-run -a playwright test --project=webkit --workers=1 --headed",
    "test:e2e:webkit:desktop": "playwright test --project=webkit --workers=1 --headed",
    "test:e2e:webkit:wayland": "./scripts/e2e-webkit-wayland.sh",
    "nightly": "node scripts/nightly-e2e.mjs",
    "lint": "eslint src --max-warnings=999",
    "test:e2e": "playwright test --project=chromium",
    "test:perf": "playwright test --project=perf --workers=1",
    "test:visual": "GS1_VISUAL=1 playwright test --project=chromium e2e/visual.spec.ts --workers=1",
    "test:visual:update": "GS1_VISUAL=1 GS1_VISUAL_UPDATE=1 playwright test --project=chromium e2e/visual.spec.ts --workers=1 --update-snapshots",
    "verify:ci": "node scripts/verify-ci.mjs",
    "verify:release": "node scripts/release.mjs --check",
    "release": "node scripts/release.mjs",
    "release:fast": "node scripts/release.mjs --skip-verify --skip-e2e",
    "rollback": "node scripts/rollback.mjs",
    "rollback:selftest": "node scripts/rollback.mjs --self-test",
    "rollback:drill": "node scripts/rollback-drill.mjs",
    "bench": "node scripts/bench.mjs --update",
    "verify:bench": "node scripts/bench.mjs",
    "bench:long": "node scripts/bench.mjs --long"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/space-grotesk": "^5.1.1",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "binaryen": "^132.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^4.130.0"
  }
}
